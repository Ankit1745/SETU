# SETU (सेतु) Production Environment Variables

PORT=5000

# MongoDB Database (Replace with your own connection string; NEVER commit real credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/setu?retryWrites=true&w=majority

# Auth & Admin Secrets (Required in production)
JWT_SECRET=replace_with_a_long_random_jwt_secret
ADMIN_SECRET_KEY=replace_with_a_strong_admin_passcode

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_sampleKey123
RAZORPAY_KEY_SECRET=sampleSecretKey456

# SMS Gateway
SMS_API_KEY=your_fast2sms_api_key_here

# Google Gemini AI Vision (Backend & Client)
GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
